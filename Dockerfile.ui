FROM python:3.11-slim

WORKDIR /app

# 只安装前端需要的轻量级依赖
COPY requirements-ui.txt .
RUN pip install --no-cache-dir -r requirements-ui.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# 🌟 核心修改：复制前端入口与多页面目录（st.Page 依赖 pages/ 下的文件，缺了会启动即报错）
COPY app_ui.py .
COPY pages ./pages

EXPOSE 8501

CMD ["streamlit", "run", "app_ui.py", "--server.port=8501", "--server.address=0.0.0.0"]